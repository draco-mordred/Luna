{
  "appId": "com.avalon.luna",
  "productName": "Luna",
  "directories": {
    "buildResources": "public"
  },
  "files": [
    "build/**/*",
    "public/electron.js",
    "public/preload.js"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "public/icon.ico"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "public/entitlements.mac.plist",
    "entitlementsInherit": "public/entitlements.mac.plist"
  },
  "linux": {
    "target": ["AppImage", "deb", "snap"],
    "icon": "public/icon.png",
    "category": "AudioVideo;Audio;Player;"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "displayLanguageSelector": true,
    "multiLanguageInstaller": true,
    "installerLanguages": [
      "en_US",
      "de_DE",
      "fr_FR",
      "es_ES",
      "zh_CN",
      "zh_TW",
      "ja_JP",
      "ko_KR",
      "it_IT",
      "nl_NL",
      "da_DK",
      "sv_SE",
      "nb_NO",
      "fi_FI",
      "ru_RU",
      "pt_PT",
      "pt_BR",
      "pl_PL",
      "uk_UA",
      "cs_CZ",
      "sk_SK",
      "hu_HU",
      "ar_SA",
      "tr_TR",
      "th_TH",
      "vi_VN"
    ],
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "installerHeader": "installer-header.bmp",
    "installerSidebar": "installer-sidebar.bmp",
    "uninstallerSidebar": "installer-sidebar.bmp",
    "include": "installer.nsh"
  },
  "portable": {
    "artifactName": "Luna-Music-${version}-portable.${ext}"
  },
  "dmg": {
    "artifactName": "Luna-Music-${version}.${ext}",
    "background": "public/dmg-background.png",
    "iconSize": 128,
    "window": {
      "width": 540,
      "height": 420
    }
  },
  "extraResources": [
    {
      "from": "public/",
      "to": "public/",
      "filter": ["**/*"]
    }
  ]
}
