{
  "name": "luna-player",
  "version": "1.1.261026",
  "private": true,
  "main": "public/electron.js",
  "description": "A music player built with React, Electron, and Capacitor.",
  "author": "Avalon Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draco-mordred/Luna.git"
  },
  "homepage": ".",
  "dependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@fontsource/material-symbols-rounded": "^5.3.9",
    "@fontsource/material-symbols-sharp": "^5.3.9",
    "@fontsource/poppins": "^5.3.0",
    "chardet": "^2.2.0",
    "iconv-lite": "^0.7.3",
    "music-metadata": "^7.14.0",
    "node-taglib-sharp": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.17.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "dev": "node scripts/dev-electron.js",
    "start": "react-scripts start",
    "build": "node scripts/check-release-notes.js && react-scripts build",
    "eslint": "eslint ./src",
    "prettier": "prettier --check **",
    "prettier fix": "prettier --write **",
    "release:version": "node scripts/set-release-version.js",
    "release:version:check": "node scripts/set-release-version.js --dry-run",
    "release:notes:create": "node scripts/create-release-notes.js",
    "release:build": "npm run release:version && npm run electron:build",
    "electron:dev": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:package": "npm run build && electron-builder --dir",
    "cap:add": "npx cap add",
    "cap:copy": "npx cap copy",
    "cap:open": "npx cap open",
    "cap:sync": "npx cap sync"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0",
    "wait-on": "^7.0.1"
  }
}
